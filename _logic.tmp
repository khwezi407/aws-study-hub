function renderServiceGrid(domain){
  const cards=SERVICE_CARDS[domain]||[];
  if(cards.length===0) return '';
  return `<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:.75rem;margin-top:1rem">
    ${cards.map(c=>`<div class="service-card">
      <span class="service-emoji">${c.emoji}</span>
      <div class="service-name">${c.name}</div>
      <div class="service-hook">${c.hook}</div>
    </div>`).join('')}
  </div>`;
}

