// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  RATIONALE ENGINE
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function genRationale(q){
  if(q.rationale&&q.rationale.length>10) return q.rationale;
  const stemLc=q.stem.toLowerCase();
  const correctOpts=q.options.filter(o=>q.correct.some(c=>o.startsWith(c+'.')));
  for(const [pattern,answer] of EXAM_PATTERNS){
    if(stemLc.match(pattern)){return answer+'. This matches the key concept tested in the question.';}
  }
  const correctSvcs=[];
  for(const opt of correctOpts){
    const text=opt.replace(/^[A-E]\.\s*/,'');
    for(const key of Object.keys(SVC).sort((a,b)=>b.length-a.length)){
      if(text.includes(key)){correctSvcs.push({name:key,desc:SVC[key]});break;}
    }
  }
  if(correctSvcs.length>0){
    return correctSvcs.map(s=>`${s.name} is ${s.desc}`).join('. ')+'. This is the concept the question is testing.';
  }
  const correctText=correctOpts.map(o=>o.replace(/^[A-E]\.\s*/,'')).join(', ');
  return `The correct answer is ${correctText}. This best matches the requirement described in the question.`;
}
function genWrongRationale(q){
  if(q.wrongRationale&&Object.keys(q.wrongRationale).length>0) return q.wrongRationale;
  const wrongOpts=q.options.filter(o=>!q.correct.some(c=>o.startsWith(c+'.')));
  const result={};
  for(const opt of wrongOpts){
    const letter=opt.charAt(0);
    const text=opt.replace(/^[A-E]\.\s*/,'');
    let desc=null;
    for(const key of Object.keys(SVC).sort((a,b)=>b.length-a.length)){
      if(text.includes(key)){desc=`${key} is ${SVC[key]}`;break;}
    }
    result[letter]=desc?desc+'. It does not match what the question is asking for.':
      `${text} does not address the specific requirement in this question.`;
  }
  return result;
}
function getRationale(q){return genRationale(q);}
function getWrongRationale(q){return genWrongRationale(q);}

