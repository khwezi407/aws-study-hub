function renderCloudMap(){
  return `
  <div class="card-sm" style="margin-bottom:1rem">
    <h2>ðŸ—ºï¸ Cloud Map â€” Every Service at a Glance</h2>
    <p class="muted" style="font-size:.875rem">Each card is a memory hook. The emoji = the mental image. The tagline = what it does in one sentence. Hover for the 3D lift.</p>
  </div>
  ${DOMAINS.map(d=>`
  <div class="card animate-in" style="margin-bottom:1.1rem">
    <h3 style="display:flex;align-items:center;gap:.5rem;margin-bottom:.25rem">
      <span>${DOMAIN_EMOJI[d]}</span>
      <span class="badge ${DOMAIN_BADGE[d]}">${DOMAIN_SHORT[d]}</span>
      <span style="font-size:.92rem">${d}</span>
    </h3>
    ${renderServiceGrid(d)}
  </div>`).join('')}`;
}

