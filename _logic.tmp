  ['block storage|virtual hard drive|attached.*EC2','EBS â€” block storage attached to one EC2 instance, tied to one AZ'],
  ['shared file|NFS|mount.*multiple.*EC2','EFS â€” managed NFS file system mountable by many EC2 instances'],
  ['serverless|event.*triggered|no server.*manage','Lambda â€” serverless compute, runs code on events, pay per execution'],
  ['container.*no.*EC2|serverless.*container','Fargate â€” serverless container runtime, AWS manages infrastructure'],
  ['Kubernetes','EKS â€” managed Kubernetes, AWS runs the control plane'],
  ['deploy.*code.*automatic|PaaS|upload.*code.*AWS.*handle','Elastic Beanstalk â€” PaaS, upload code, AWS handles deployment'],
  ['message queue|decouple|asynchronous.*process','SQS â€” managed queue, one consumer per message'],
  ['pub.*sub|fan out|notification.*multiple','SNS â€” pub/sub, fans out one message to many subscribers'],
  ['domain name|DNS|route.*latency|route.*geolocation','Route 53 â€” managed DNS with routing policies'],
  ['CDN|content.*delivery|edge.*cache|low latency.*global','CloudFront â€” CDN, caches at edge locations globally'],
  ['distribute.*traffic|load balanc|health check','ELB â€” distributes traffic across targets, health checks'],
  ['scale.*in.*out|auto.*scal.*EC2|match.*demand','Auto Scaling â€” automatically adds/removes EC2 instances'],
  ['large.*data.*transfer.*offline|physical device|100.*TB','Snowball/Snowmobile â€” physical devices for offline data transfer'],
  ['private.*connection.*AWS|dedicated.*physical|bypass.*internet','Direct Connect â€” dedicated private physical network connection'],
  ['hybrid.*storage|on-prem.*cloud','Storage Gateway â€” hybrid storage, connects on-premises apps to cloud'],
  ['migrate database|minimal downtime','DMS â€” Database Migration Service'],
  ['SQL.*S3|query.*S3.*without.*load','Athena â€” serverless SQL on S3 data, no loading needed'],
  ['ETL|extract.*transform.*load','Glue â€” serverless ETL service with data catalogue'],
  ['cost.*spend.*visual|billing.*history','Cost Explorer â€” visualises spending with charts'],
  ['budget.*alert|spending.*threshold|notify.*cost.*exceed','Budgets â€” sets cost/usage thresholds and sends alerts'],
  ['estimate.*cost.*before|pricing.*model','Pricing Calculator â€” estimates costs before deployment'],
  ['spot.*interrupt|90%.*discount|spare capacity','Spot Instances â€” up to 90% discount, can be interrupted with 2-min warning'],
  ['reserved.*commit|1.*year.*3.*year','Reserved Instances â€” 1 or 3 year commitment, up to 72% discount'],
  ['savings plan.*flexible','Savings Plans â€” commit to $/hour, up to 66% discount'],
  ['dedicated.*physical.*server|BYOL|bring.*own.*license','Dedicated Hosts â€” physical server for you, supports BYOL'],
  ['shared responsibility','AWS secures the cloud (hardware, hypervisor, facilities), customer secures in the cloud (data, OS, access)'],
  ['elasticity|scale.*demand','ability to automatically scale resources in and out'],
  ['CapEx.*OpEx|capital.*variable','cloud converts upfront capital expense to pay-as-you-go operational expense'],
  ['economies of scale','AWS aggregates demand across millions of customers, lowering per-unit costs'],
  ['loose coupling|decouple','reduce dependencies between components â€” SQS and SNS enable this'],
  ['design for failure','assume every component will fail and design the system to continue despite it'],
