(function(){
  const today=new Date().toDateString();
  if(streak.lastDate===today){/* same day */}
  else if(streak.lastDate===new Date(Date.now()-86400000).toDateString()){streak.count++;streak.lastDate=today;}
  else{streak.count=1;streak.lastDate=today;}
  saveAll();
})();

