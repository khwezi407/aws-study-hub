const EXAM_DATE=new Date('2026-12-14T07:00:00');
const DOMAINS=['Cloud Concepts','Security and Compliance','Cloud Technology and Services','Billing, Pricing and Support'];
const DOMAIN_SHORT={'Cloud Concepts':'CC','Security and Compliance':'SEC','Cloud Technology and Services':'TECH','Billing, Pricing and Support':'BILL'};
const DOMAIN_WEIGHT={'Cloud Concepts':0.24,'Security and Compliance':0.30,'Cloud Technology and Services':0.34,'Billing, Pricing and Support':0.12};
const DOMAIN_BADGE={'Cloud Concepts':'badge-cc','Security and Compliance':'badge-sec','Cloud Technology and Services':'badge-tech','Billing, Pricing and Support':'badge-bill'};
const DOMAIN_COLOR={'Cloud Concepts':'var(--cc)','Security and Compliance':'var(--sec)','Cloud Technology and Services':'var(--tech)','Billing, Pricing and Support':'var(--bill)'};
const DOMAIN_EMOJI={'Cloud Concepts':'â˜ï¸','Security and Compliance':'ðŸ›¡ï¸','Cloud Technology and Services':'âš™ï¸','Billing, Pricing and Support':'ðŸ’°'};
const DOMAIN_HOVER={'Cloud Concepts':'card-hover-cc','Security and Compliance':'card-hover-sec','Cloud Technology and Services':'card-hover-tech','Billing, Pricing and Support':'card-hover-bill'};
const INTERVALS=[1,2,4,7];

function daysLeft(){
  const ms=EXAM_DATE-new Date();
  return Math.max(0,Math.ceil(ms/(1000*60*60*24)));
}

// localStorage
function load(key,def){try{const v=localStorage.getItem(key);return v?JSON.parse(v):def;}catch{return def;}}
function save(key,val){try{localStorage.setItem(key,JSON.stringify(val));}catch{}}

let progress=load('clf_progress',{});
let history=load('clf_history',[]);
let confusions=load('clf_confusions',{});
let diagnostic=load('clf_diagnostic',null);
let xp=load('clf_xp',0);
let streak=load('clf_streak',{count:0,lastDate:''});

function saveAll(){
  save('clf_progress',progress);
  save('clf_history',history);
  save('clf_confusions',confusions);
  save('clf_diagnostic',diagnostic);
  save('clf_xp',xp);
  save('clf_streak',streak);
}

function getQ(id){return window.QUESTIONS.find(q=>q.id===id);}

function domainAccuracy(domain){
  const qs=window.QUESTIONS.filter(q=>q.domain===domain);
  let correct=0,total=0;
  qs.forEach(q=>{const p=progress[q.id];if(p&&p.attempts>0){total+=p.attempts;correct+=p.correct;}});
  return total===0?null:Math.round(correct/total*100);
}
function overallAccuracy(){
  let correct=0,total=0;
  Object.values(progress).forEach(p=>{if(p.attempts>0){total+=p.attempts;correct+=p.correct;}});
  return total===0?null:Math.round(correct/total*100);
}
function dueItems(){
  const now=Date.now();
  return window.QUESTIONS.filter(q=>{
    const p=progress[q.id];
    if(!p) return true;
    if(p.interval===INTERVALS.length-1&&p.correct>0) return false;
    return now>=p.nextDue;
  });
}

function recordAnswer(qid,chosen,correct){
  if(!progress[qid]) progress[qid]={interval:0,nextDue:0,correct:0,attempts:0};
  const p=progress[qid];
  p.attempts++;
  const now=Date.now();
  if(correct){
    p.correct++;
    const idx=Math.min((p.interval||0)+1,INTERVALS.length-1);
    p.interval=idx;
    p.nextDue=now+INTERVALS[idx]*86400000;
    addXP(10);
  } else {
    p.interval=0;
    p.nextDue=now+INTERVALS[0]*86400000;
    addXP(2);
    const q=getQ(qid);
    if(q&&chosen.length===1&&q.correct.length===1){
      const chosenLabel=q.options.find(o=>o.startsWith(chosen[0]+'.'))?.replace(/^[A-D]\.\s*/,'')||chosen[0];
      const correctLabel=q.options.find(o=>o.startsWith(q.correct[0]+'.'))?.replace(/^[A-D]\.\s*/,'')||q.correct[0];
      const ck=`${chosenLabel}|${correctLabel}`;
      if(!confusions[ck]) confusions[ck]={count:0,lastSeen:0,aLabel:chosenLabel,bLabel:correctLabel};
      confusions[ck].count++;
      confusions[ck].lastSeen=now;
    }
  }
  saveAll();
}

function addXP(amount){
  xp+=amount;
  updateStreakDisplay();
}

function showXPFloat(amount,x,y){
  const el=document.createElement('div');
  el.className='xp-float';
  el.textContent=`+${amount} XP`;
  el.style.left=(x||window.innerWidth/2-20)+'px';
  el.style.top=(y||300)+'px';
  document.body.appendChild(el);
  setTimeout(()=>el.remove(),1000);
}

function updateStreakDisplay(){
  const el=document.getElementById('sidebar-xp');
  if(!el) return;
  const level=Math.floor(xp/200)+1;
  const xpInLevel=xp%200;
  el.innerHTML=`
    <div style="font-size:.68rem;color:var(--muted);margin-bottom:.4rem;text-transform:uppercase;letter-spacing:.06em">Your Progress</div>
    <div class="xp-pill" style="margin-bottom:.35rem">âš¡ ${xp} XP Â· Level ${level}</div>
    <div class="progress-wrap" style="height:4px"><div class="progress-fill ok" style="width:${(xpInLevel/200*100).toFixed(0)}%"></div></div>
    <div style="font-size:.66rem;color:var(--muted2);margin-top:.3rem">${200-xpInLevel} XP to Level ${level+1}</div>
  `;
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  NAVIGATION
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
let currentTab='home';
let countdownInterval=null;

function navigate(tab){
  currentTab=tab;
  if(countdownInterval){clearInterval(countdownInterval);countdownInterval=null;}
  document.querySelectorAll('.nav-btn').forEach(b=>{
    b.classList.toggle('active',b.dataset.tab===tab);
  });
  renderTab(tab);
}

document.querySelectorAll('.nav-btn').forEach(b=>{
  b.addEventListener('click',()=>navigate(b.dataset.tab));
});

function renderTab(tab){
  const el=document.getElementById('main-content');
  el.style.opacity='0';
  el.style.transform='translateY(8px)';
  setTimeout(()=>{
    if(tab==='home') el.innerHTML=renderHome();
    else if(tab==='diagnostic') el.innerHTML=renderDiagnosticMenu();
    else if(tab==='practice') el.innerHTML=renderPracticeMenu();
    else if(tab==='mock') el.innerHTML=renderMockMenu();
    else if(tab==='progress') el.innerHTML=renderProgress();
    el.style.opacity='1';
    el.style.transform='translateY(0)';
    el.style.transition='opacity .25s, transform .25s';
    attachTabListeners(tab);
    if(tab==='home') startCountdown();
  },80);
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  TOAST
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
let toastTimer;
function toast(msg,type=''){
  const el=document.getElementById('toast');
  el.textContent=msg;
  el.className='toast show'+(type?' toast-'+type:'');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>{el.className='toast';},2800);
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  CONFETTI BURST
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function confettiBurst(x,y){
  const colors=['#f59e0b','#22c55e','#38bdf8','#a78bfa','#fbbf24','#4ade80'];
  for(let i=0;i<16;i++){
    const piece=document.createElement('div');
    piece.className='confetti-piece';
    piece.style.left=(x+Math.random()*80-40)+'px';
    piece.style.top=y+'px';
    piece.style.background=colors[i%colors.length];
    piece.style.transform=`rotate(${Math.random()*360}deg)`;
    piece.style.animationDelay=(Math.random()*0.3)+'s';
    document.body.appendChild(piece);
    setTimeout(()=>piece.remove(),1000);
  }
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  COUNTDOWN TIMER
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function startCountdown(){
  function tick(){
    const now=new Date();
    const diff=EXAM_DATE-now;
    if(diff<=0){
      ['cd-days','cd-hours','cd-mins','cd-secs'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent='00';});
      return;
    }
    const days=Math.floor(diff/(1000*60*60*24));
    const hours=Math.floor((diff%(1000*60*60*24))/(1000*60*60));
    const mins=Math.floor((diff%(1000*60*60))/(1000*60));
    const secs=Math.floor((diff%(1000*60))/1000);
    const ids=['cd-days','cd-hours','cd-mins','cd-secs'];
    const vals=[days,hours,mins,secs];
    ids.forEach((id,i)=>{
      const el=document.getElementById(id);
      if(el){
        const newVal=String(vals[i]).padStart(2,'0');
        if(el.textContent!==newVal){
          el.textContent=newVal;
          el.classList.add('tick');
          setTimeout(()=>el.classList.remove('tick'),150);
        }
      }
    });
  }
  tick();
  countdownInterval=setInterval(tick,1000);
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  HOME TAB
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function renderReadinessRing(score,color){
  const r=48,cx=60,cy=60,circ=2*Math.PI*r;
  const dash=(score/100)*circ;
  return `<div class="readiness-ring">
    <svg width="120" height="120" viewBox="0 0 120 120">
      <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="10"/>
      <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${color}" stroke-width="10"
        stroke-dasharray="${dash.toFixed(1)} ${circ.toFixed(1)}"
        stroke-linecap="round"
        style="filter:drop-shadow(0 0 8px ${color});transition:stroke-dasharray .9s cubic-bezier(.4,0,.2,1)"/>
    </svg>
    <div class="readiness-num">
      <span style="color:${color}">${score}<span style="font-size:.95rem">%</span></span>
      <span class="readiness-label">Readiness</span>
    </div>
  </div>`;
}

function renderHome(){
  const days=daysLeft();
  const due=dueItems().length;
  const overall=overallAccuracy();
  const diagDone=!!diagnostic;
  const mockCount=history.filter(h=>h.mode==='mock').length;
  const lastMock=history.filter(h=>h.mode==='mock').slice(-1)[0];
  const totalAttempted=Object.values(progress).filter(p=>p.attempts>0).length;
  const domainsPracticed=DOMAINS.filter(d=>domainAccuracy(d)!==null).length;

  let score=0,statusText='Early Stage ðŸŒ±',statusColor='var(--err)',advice='';
  if(totalAttempted===0){
    score=0;advice='Take the diagnostic exam first â€” it sets your personalised starting point.';
  } else if(mockCount===0){
    score=Math.round((overall||0)*0.7+(domainsPracticed/4)*30);
    score=Math.min(100,score);
    advice='Looking good! Take a full mock exam next to test yourself under real exam conditions.';
  } else {
    const mocks=history.filter(h=>h.mode==='mock');
    const avgMock=Math.round(mocks.slice(-3).reduce((s,m)=>s+m.score,0)/Math.min(mocks.length,3));
    score=Math.min(100,Math.round((overall||0)*0.25+avgMock*0.5+(domainsPracticed/4)*25));
    advice=score>=90?'You are exam-ready. Keep doing daily review. One more mock and you are there ðŸ†':
           score>=75?'So close! Push harder on weak domains. Daily mock exams will get you over the line ðŸ”¥':
           'Focus on your weakest domain today. Practice 20 questions, then review every wrong answer.';
  }
  if(score>=90){statusText='Exam-Ready ðŸ†';statusColor='var(--ok)';}
  else if(score>=75){statusText='Almost There ðŸ”¥';statusColor='var(--accent)';}
  else if(score>=55){statusText='Building Up ðŸ“ˆ';statusColor='var(--accent)';}

  const phase=days>10?'rehearsal':'sprint';
  const sprintDay=days>10?days-10:11-days;
  let planHTML='';
  if(!diagDone){
    planHTML=`<div class="card-sm card-accent animate-in" style="margin-top:.75rem">
      <div class="label" style="color:var(--accent)">First Step</div>
      <p style="margin-top:.4rem;font-size:.88rem">Take the <strong>Diagnostic Exam</strong> to identify your weak spots. It takes ~60 minutes and will personalise your whole plan.</p>
      <button class="btn btn-primary btn-sm" style="margin-top:.75rem" onclick="navigate('diagnostic')">Start Diagnostic â†’</button>
    </div>`;
  } else {
    const domainScores=DOMAINS.map(d=>({domain:d,acc:domainAccuracy(d)}));
    domainScores.sort((a,b)=>(a.acc===null?-1:b.acc===null?1:a.acc-b.acc));
    const sprintPlans=[
      {days:[1,2],label:'ðŸŽ¯ Foundation',items:['Review all due items (spaced repetition)','Study Cloud Concepts â€” Key Terms tab','Study Security & Compliance â€” Exam Keywords','Practice 20 questions in each domain','Review every wrong answer â€” read the WHY carefully']},
      {days:[3,4],label:'âš™ï¸ Technology Deep-Dive',items:['Review all due items (spaced repetition)','Study Cloud Technology services + comparisons','Practice 25 Technology questions','Run Practice Exam #1 or #2 (kananinirav set)','Study the Exam Keywords tab â€” memorise patterns']},
      {days:[5,6],label:'ðŸ’° Billing + First Mock',items:['Review all due items (spaced repetition)','Study Billing, Pricing & Support (smallest domain â€” learn it cold)','Practice 15 Billing questions','Take your FIRST full Mock Exam (65 Qs, 90 min)','Analyse results â€” which domain dropped the most?']},
      {days:[7,8],label:'ðŸ” Mock Reps',items:['Review all due items (spaced repetition)','Run full Mock Exam #2 â€” aim for 80%+','Weakness Drill for your top 3 confusion pairs','Run Practice Exams #5-#8 for variety','Re-read Exam Keywords â€” these are your answer shortcuts']},
      {days:[9,10],label:'ðŸ† Final Push',items:['Review all due items (spaced repetition)','Run full Mock Exam â€” aim for 90%+','Focus ONLY on wrong answers and weak domains','Re-read Key Terms and Exam Keywords once more','Stop learning new material â€” consolidate what you know']},
    ];
    const sp=sprintPlans.find(s=>s.days.includes(sprintDay))||sprintPlans[0];
    const phaseLabel=phase==='sprint'?`${sp.label} Â· Day ${sprintDay}/10`:`ðŸŒ™ Rehearsal Phase Â· Day ${Math.abs(sprintDay)}`;
    const items=phase==='sprint'?sp.items:['Review all due items (spaced repetition) â€” your main daily task','Run one full Mock Exam per day â€” aim for 90%+ consistently','Review wrong answers only â€” no new material','Re-read Exam Keywords once (5 minutes)','Sleep well â€” memory consolidates during sleep ðŸ§ '];
    planHTML=`<div class="card-sm animate-in" style="margin-top:.75rem;border-left:3px solid var(--accent)">
      <div class="label" style="color:var(--accent)">${phaseLabel}</div>
      <ol style="padding-left:1.3rem;margin-top:.6rem;font-size:.875rem;line-height:2.1">
        ${items.map(i=>`<li>${i}</li>`).join('')}
      </ol>
      <p style="font-size:.76rem;color:var(--muted);margin-top:.6rem">â±ï¸ Planned time: 2â€“3 hours. When done â€” stop. Rest is part of learning.</p>
    </div>`;
  }

  // Daily missions
  const missions=[
    {text:`Review ${Math.min(due,20)} due items`,done:due===0},
    {text:'Practice 10 questions in weakest domain',done:false},
    {text:mockCount>0?'Run a full Mock Exam':'Take the Diagnostic Exam',done:false},
  ];

  return `
  <!-- COUNTDOWN BANNER -->
  <div class="days-banner animate-in">
    <div>
      <div class="label" style="color:var(--accent);margin-bottom:.5rem">Time until exam Â· 14 Dec 2026</div>
      <div class="countdown-grid">
        <div class="countdown-unit">
          <div class="countdown-num" id="cd-days">--</div>
          <div class="countdown-label">Days</div>
        </div>
        <div class="countdown-sep">:</div>
        <div class="countdown-unit">
          <div class="countdown-num" id="cd-hours">--</div>
          <div class="countdown-label">Hours</div>
        </div>
        <div class="countdown-sep">:</div>
        <div class="countdown-unit">
          <div class="countdown-num" id="cd-mins">--</div>
          <div class="countdown-label">Mins</div>
        </div>
        <div class="countdown-sep">:</div>
        <div class="countdown-unit">
          <div class="countdown-num" id="cd-secs">--</div>
          <div class="countdown-label">Secs</div>
        </div>
      </div>
    </div>
    <div class="days-info">
      <h2>AWS Certified Cloud Practitioner</h2>
      <p>CLF-C02 Â· Final exam date</p>
      ${days<=7?`<p style="color:var(--err);font-weight:700;margin-top:.3rem">âš ï¸ Final stretch â€” mock exams only!</p>`:''}
    </div>
    <div style="display:flex;flex-direction:column;align-items:center;gap:.5rem">
      <span class="streak-pill"><span class="flame">ðŸ”¥</span> ${streak.count} day streak</span>
      <span class="xp-pill">âš¡ ${xp} XP</span>
    </div>
  </div>

  <!-- READINESS CARD -->
  <div class="card card-glow-amber animate-in stagger-1" style="margin-bottom:1.25rem">
    <h2>ðŸŽ¯ Exam Readiness</h2>
    <div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap">
      ${renderReadinessRing(score,statusColor)}
      <div style="flex:1;min-width:180px">
        <div style="font-size:1.05rem;font-weight:800;color:${statusColor};margin-bottom:.3rem">${statusText}</div>
        <p style="font-size:.875rem;color:var(--muted);line-height:1.6">${advice}</p>
        <div style="margin-top:.5rem;font-size:.73rem;color:var(--muted2)">${totalAttempted} questions attempted Â· ${domainsPracticed}/4 domains Â· ${mockCount} mock${mockCount!==1?'s':''} done</div>
      </div>
    </div>
  </div>

  <!-- STAT ROW -->
  <div class="grid-4 animate-in stagger-2" style="margin-bottom:1.25rem">
    <div class="stat">
      <div class="stat-num" style="color:var(--info)">${window.QUESTIONS.length}</div>
      <div class="stat-label">Questions</div>
    </div>
    <div class="stat">
      <div class="stat-num" style="color:${due>0?'var(--err)':'var(--ok)'}">${due}</div>
      <div class="stat-label">Due Today</div>
    </div>
    <div class="stat">
      <div class="stat-num" style="color:${overall===null?'var(--muted)':overall>=80?'var(--ok)':overall>=60?'var(--accent)':'var(--err)'}">${overall===null?'â€”':overall+'%'}</div>
      <div class="stat-label">Accuracy</div>
    </div>
    <div class="stat">
      <div class="stat-num" style="color:var(--flag)">${mockCount}</div>
      <div class="stat-label">Mocks Done</div>
    </div>
  </div>

  <!-- DOMAIN BARS -->
  <div class="card animate-in stagger-3" style="margin-bottom:1.25rem">
    <h2>Domain Overview</h2>
    ${DOMAINS.map(d=>{
      const acc=domainAccuracy(d);
      const pct=acc===null?0:acc;
      const color=DOMAIN_COLOR[d];
      return `<div style="margin-bottom:.9rem">
        <div style="display:flex;justify-content:space-between;margin-bottom:.3rem;align-items:center">
          <span style="font-size:.875rem;font-weight:600">${DOMAIN_EMOJI[d]} ${d}</span>
          <div style="display:flex;align-items:center;gap:.5rem">
            <span class="badge ${DOMAIN_BADGE[d]}">${Math.round(DOMAIN_WEIGHT[d]*100)}%</span>
            <span style="font-size:.875rem;font-weight:800;color:${acc===null?'var(--muted)':color}">${acc===null?'â€”':acc+'%'}</span>
          </div>
        </div>
        <div class="progress-wrap">
          <div class="progress-fill" style="width:${pct}%;background:linear-gradient(90deg,${color},${color}99);box-shadow:0 0 8px ${color}60"></div>
        </div>
      </div>`;
    }).join('')}
  </div>

  <!-- DAILY MISSIONS -->
  <div class="card animate-in stagger-4" style="margin-bottom:1.25rem">
    <h2>ðŸŽ–ï¸ Daily Missions</h2>
    ${missions.map((m,i)=>`<div class="mission-item">
      <div class="mission-check ${m.done?'done':''}">${m.done?'âœ“':i+1}</div>
      <span style="color:${m.done?'var(--muted)':'var(--text)'};text-decoration:${m.done?'line-through':'none'}">${m.text}</span>
    </div>`).join('')}
  </div>

  <!-- STUDY PLAN -->
  <div class="card animate-in" style="margin-bottom:1.25rem">
    <h2>ðŸ“… Today's Study Plan</h2>
    ${planHTML}
  </div>

  <!-- LAST MOCK -->
  ${lastMock?`<div class="card-sm animate-in" style="margin-bottom:1.25rem;border-color:${lastMock.score>=90?'rgba(34,197,94,0.3)':lastMock.score>=70?'rgba(245,158,11,0.3)':'rgba(239,68,68,0.3)'}">
    <div class="label">Last Mock Exam</div>
    <div style="margin-top:.4rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
      <span style="font-size:1.8rem;font-weight:900;color:${lastMock.score>=90?'var(--ok)':lastMock.score>=70?'var(--accent)':'var(--err)'}">${lastMock.score}%</span>
      <span class="muted">${new Date(lastMock.date).toLocaleDateString()}</span>
      <button class="btn btn-secondary btn-sm" onclick="navigate('mock')">Take Another â†’</button>
    </div>
  </div>`:''}

  <!-- QUICK ACTIONS -->
  <div style="display:flex;gap:.75rem;flex-wrap:wrap">
    ${due>0?`<button class="btn btn-primary" onclick="startPractice('due')">ðŸ“Œ Review Due (${due})</button>`:''}
    <button class="btn btn-secondary" onclick="navigate('mock')">â±ï¸ Start Mock Exam</button>
    <button class="btn btn-secondary" onclick="navigate('practice')">ðŸ“š Practice</button>
  </div>`;
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  DIAGNOSTIC TAB
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function renderDiagnosticMenu(){
  if(diagnostic){
    const canRetake=!diagnostic.date||(Date.now()-diagnostic.date>7*86400000);
    const scores=diagnostic.scores||{};
    return `
    <div class="section-header"><h1>ðŸ” Diagnostic Results</h1></div>
    <div class="card card-glow-blue" style="margin-bottom:1rem">
      <div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;margin-bottom:1.25rem">
        ${renderReadinessRing(diagnostic.score,diagnostic.score>=80?'var(--ok)':diagnostic.score>=60?'var(--accent)':'var(--err)')}
        <div>
          <div class="label" style="margin-bottom:.4rem">Overall Diagnostic Score</div>
          <div style="font-size:1rem;font-weight:600;margin-bottom:.2rem">${new Date(diagnostic.date).toLocaleDateString()} Â· ${diagnostic.total} questions</div>
          <div class="muted" style="font-size:.875rem">${diagnostic.score>=80?'Strong start â€” now do mock exams':diagnostic.score>=60?'Good baseline â€” focus on the red domains below':'Needs work â€” start with weakest domain daily'}</div>
        </div>
      </div>
      ${DOMAINS.map(d=>{
        const pct=scores[d]||0;const color=DOMAIN_COLOR[d];
        return `<div style="margin-bottom:.75rem">
          <div style="display:flex;justify-content:space-between;margin-bottom:.3rem;align-items:center">
            <span style="display:flex;align-items:center;gap:.5rem">
              <span class="badge ${DOMAIN_BADGE[d]}">${DOMAIN_SHORT[d]}</span>
              <span style="font-size:.85rem">${d}</span>
            </span>
            <span style="font-weight:800;color:${pct>=80?'var(--ok)':pct>=60?'var(--accent)':'var(--err)'}">${pct}%</span>
          </div>
          <div class="progress-wrap">
            <div class="progress-fill" style="width:${pct}%;background:linear-gradient(90deg,${color},${color}aa);box-shadow:0 0 8px ${color}60"></div>
          </div>
        </div>`;
      }).join('')}
    </div>
    <div class="card-sm card-accent" style="margin-bottom:1rem">
      <h3>ðŸ’¡ Recommended Focus</h3>
      ${DOMAINS.filter(d=>(scores[d]||0)<70).length===0
        ?'<p class="muted" style="font-size:.875rem">Strong across all domains. Keep up the mock exams!</p>'
        :`<ul style="padding-left:1.2rem;margin-top:.4rem;font-size:.88rem;line-height:2;color:var(--muted)">
           ${DOMAINS.filter(d=>(scores[d]||0)<70).map(d=>`<li>${DOMAIN_EMOJI[d]} <strong style="color:var(--text)">${d}</strong> â€” ${scores[d]||0}% â†’ practice these questions first</li>`).join('')}</ul>`}
    </div>
    ${canRetake?`<button class="btn btn-secondary" onclick="startDiagnostic()">â†©ï¸ Retake Diagnostic</button>`:'<p class="muted" style="font-size:.875rem">Retake available in 7 days.</p>'}`;
  }
  return `
  <div class="section-header"><h1>ðŸ” Diagnostic Exam</h1></div>
  <div class="card card-glow-blue" style="margin-bottom:1.25rem">
    <h2>Establish your baseline</h2>
    <p class="muted" style="margin-bottom:1.1rem;font-size:.88rem">The diagnostic tests all four CLF-C02 domains so your study plan starts from your actual level, not from scratch.</p>
    <div class="grid-4" style="margin-bottom:1.25rem">
      <div class="stat"><div class="stat-num">40</div><div class="stat-label">Questions</div></div>
      <div class="stat"><div class="stat-num">60</div><div class="stat-label">Min (soft)</div></div>
      <div class="stat"><div class="stat-num">4</div><div class="stat-label">Domains</div></div>
      <div class="stat"><div class="stat-num">1Ã—</div><div class="stat-label">Per 7 days</div></div>
    </div>
    <div class="card-sm" style="margin-bottom:1.25rem">
      <div class="label" style="margin-bottom:.6rem">Domain Distribution</div>
      ${[['Cloud Concepts','10','badge-cc'],['Security and Compliance','12','badge-sec'],['Cloud Technology and Services','14','badge-tech'],['Billing, Pricing and Support','4','badge-bill']].map(([d,n,b])=>`
      <div style="display:flex;align-items:center;justify-content:space-between;padding:.35rem 0;border-bottom:1px solid var(--border)">
        <span style="font-size:.875rem">${DOMAIN_EMOJI[d]} ${d}</span>
        <span class="badge ${b}">${n} Qs</span>
      </div>`).join('')}
    </div>
    <button class="btn btn-primary" onclick="startDiagnostic()">Begin Diagnostic â†’</button>
  </div>`;
}

function startDiagnostic(){
  const counts={'Cloud Concepts':10,'Security and Compliance':12,'Cloud Technology and Services':14,'Billing, Pricing and Support':4};
  let qs=[];
  DOMAINS.forEach(d=>{qs=qs.concat(shuffle(window.QUESTIONS.filter(q=>q.domain===d)).slice(0,counts[d]));});
  runQuiz(shuffle(qs),'diagnostic',onDiagnosticComplete);
}

function onDiagnosticComplete(results){
  const scores={};
  DOMAINS.forEach(d=>scores[d]={correct:0,total:0});
  results.forEach(r=>{const q=getQ(r.qid);if(!q)return;scores[q.domain].total++;if(r.correct)scores[q.domain].correct++;});
  const domainPct={};
  DOMAINS.forEach(d=>domainPct[d]=scores[d].total?Math.round(scores[d].correct/scores[d].total*100):0);
  const overall=Math.round(results.filter(r=>r.correct).length/results.length*100);
  diagnostic={score:overall,scores:domainPct,date:Date.now(),total:results.length};
  saveAll();
  navigate('diagnostic');
}

