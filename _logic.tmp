//  PRACTICE TAB
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
function renderPracticeMenu(){
  return `
  <div class="section-header"><h1>ðŸ“š Practice</h1></div>
  <div class="sub-tabs" id="practice-subtabs">
    <button class="sub-tab active" data-stab="by-domain">By Domain</button>
    <button class="sub-tab" data-stab="exams">Practice Exams</button>
    <button class="sub-tab" data-stab="visuals">ðŸ—ºï¸ Cloud Map</button>
    <button class="sub-tab" data-stab="keywords">ðŸ”‘ Exam Keywords</button>
    <button class="sub-tab" data-stab="terms">ðŸ“– Key Terms</button>
    <button class="sub-tab" data-stab="interview">ðŸŽ¤ Interview Prep</button>
    <button class="sub-tab" data-stab="due">Due Items</button>
    <button class="sub-tab" data-stab="weakness">ðŸ” Weakness Drill</button>
    <button class="sub-tab" data-stab="flashcards">ðŸƒ Flashcards</button>
  </div>
  <div id="practice-content">${renderPracticeByDomain()}</div>`;
}

function renderPracticeByDomain(){
  return `<div class="grid-2">
    ${DOMAINS.map(d=>{
      const acc=domainAccuracy(d);
      const count=window.QUESTIONS.filter(q=>q.domain===d).length;
      const attempted=window.QUESTIONS.filter(q=>q.domain===d&&progress[q.id]&&progress[q.id].attempts>0).length;
      const color=DOMAIN_COLOR[d];
      const pct=count>0?attempted/count*100:0;
      const hoverClass=DOMAIN_HOVER[d];
      return `<div class="card ${hoverClass}" style="border-color:${acc!==null&&acc>=80?'rgba(34,197,94,0.25)':acc!==null&&acc>=60?'rgba(245,158,11,0.18)':acc!==null?'rgba(239,68,68,0.18)':'var(--border)'}">
        <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.6rem">
          <span style="font-size:1.4rem">${DOMAIN_EMOJI[d]}</span>
          <div>
            <div style="font-size:.85rem;font-weight:700">${d}</div>
            <span class="badge ${DOMAIN_BADGE[d]}">${Math.round(DOMAIN_WEIGHT[d]*100)}% of exam</span>
          </div>
          ${acc!==null?`<span style="margin-left:auto;font-size:1.05rem;font-weight:900;color:${acc>=80?'var(--ok)':acc>=60?'var(--accent)':'var(--err)'}">${acc}%</span>`:''}
        </div>
        <div style="font-size:.76rem;color:var(--muted);margin-bottom:.6rem">${attempted}/${count} attempted</div>
        <div class="progress-wrap" style="margin-bottom:.75rem">
          <div class="progress-fill" style="width:${pct.toFixed(0)}%;background:linear-gradient(90deg,${color},${color}99)"></div>
        </div>
        <div style="display:flex;gap:.4rem;flex-wrap:wrap">
          <button class="btn btn-primary btn-sm" onclick="startPractice('domain','${d}',10)">10 Qs</button>
          <button class="btn btn-secondary btn-sm" onclick="startPractice('domain','${d}',20)">20 Qs</button>
          <button class="btn btn-secondary btn-sm" onclick="startPractice('domain','${d}',0)">All</button>
        </div>
      </div>`;
    }).join('')}
  </div>`;
}

function renderPracticeExams(){
  const examSources={};
  window.QUESTIONS.forEach(q=>{
    if(q.source){
      const match=q.source.match(/exam-(\d+)/);
      if(match){
        const num=parseInt(match[1]);
        if(!examSources[num]) examSources[num]={num,questions:[],attempted:0,correct:0};
        examSources[num].questions.push(q);
        const p=progress[q.id];
        if(p&&p.attempts>0){examSources[num].attempted++;examSources[num].correct+=p.correct;}
      }
    }
  });
  const exams=Object.values(examSources).sort((a,b)=>a.num-b.num);
  if(exams.length===0) return `<div class="card-sm"><p class="muted">No practice exams loaded. Make sure external-questions.js is present.</p></div>`;
  return `<div class="card-sm" style="margin-bottom:1rem">
    <h2>Practice Exams 1â€“${exams.length}</h2>
    <p class="muted" style="font-size:.875rem">Community practice exams. ${window.EXTERNAL_QUESTIONS?window.EXTERNAL_QUESTIONS.length:0} questions across ${exams.length} exams.</p>
  </div>
  <div class="grid-2">
    ${exams.map(e=>{
      const acc=e.attempted>0?Math.round(e.correct/e.attempted*100):null;
      return `<div class="card-sm">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.4rem">
          <span style="font-weight:800">Exam ${e.num}</span>
          ${acc!==null?`<span style="font-weight:800;color:${acc>=80?'var(--ok)':acc>=60?'var(--accent)':'var(--err)'}">${acc}%</span>`:''}
        </div>
        <div class="muted" style="font-size:.8rem;margin-bottom:.5rem">${e.questions.length} questions</div>
        <button class="btn btn-primary btn-sm" onclick="startPracticeExam(${e.num})">Start Exam ${e.num} â†’</button>
      </div>`;
    }).join('')}
  </div>`;
}

function startPracticeExam(num){
  const qs=shuffle(window.QUESTIONS.filter(q=>q.source&&q.source.includes(`exam-${num}`)));
  if(qs.length===0){toast('No questions found for this exam.','err');return;}
  runQuiz(qs,'practice',onPracticeComplete);
}

